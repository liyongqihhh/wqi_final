#!/usr/bin/env python3
"""Do not load heavy Gazebo sensors while ros2_control is still loading drivers."""
import time

import rclpy
from controller_manager_msgs.srv import ListControllers


def main():
    rclpy.init()
    node = rclpy.create_node("wait_for_carrier_control")
    client = node.create_client(ListControllers, "/controller_manager/list_controllers")
    deadline = time.monotonic() + 180.0
    wanted = {"ugvcar_joint_state_broadcaster", "ugvcar_diff_drive_controller"}
    try:
        while rclpy.ok() and time.monotonic() < deadline:
            if not client.wait_for_service(timeout_sec=1.0):
                continue
            future = client.call_async(ListControllers.Request())
            rclpy.spin_until_future_complete(node, future, timeout_sec=5.0)
            if future.done() and future.result() is not None:
                active = {c.name for c in future.result().controller if c.state == "active"}
                if wanted <= active:
                    node.get_logger().info("A-car wheel controllers are active; sensor spawning allowed")
                    return 0
            else:
                future.cancel()
            time.sleep(.2)
        node.get_logger().error("A-car controllers did not become active within 180 wall seconds")
        return 1
    except KeyboardInterrupt:
        return 1
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
