<?xml version="1.0"?>
<package format="3">
  <name>delivery_evaluation</name>
  <version>0.1.0</version>
  <description>Repeatable evaluation and reporting for campus delivery modes.</description>
  <maintainer email="liyongqihhh@users.noreply.github.com">wqi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>cooperative_delivery_interfaces</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>uav_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>campus_dynamic_obstacles</exec_depend>
  <exec_depend>cooperative_delivery</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>uav_bringup</exec_depend>
  <exec_depend>ugvcar_description</exec_depend>
  <exec_depend>ugvcar_navigation2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
