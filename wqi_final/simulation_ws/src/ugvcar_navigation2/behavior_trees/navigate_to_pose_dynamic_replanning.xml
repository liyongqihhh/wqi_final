<!--
  Dynamic-obstacle navigation checks path validity at 1 Hz and computes a new
  route when a prediction blocks the path or once whenever the active threat
  count changes. A 5 s refresh also releases detours when occupancy changes
  without a change in threat count. Valid paths change only for a meaningful
  shortening. The local predictive controller stays active during replanning.
  Recovery never commands a scripted spin or reverse.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="8" name="DynamicNavigateRecovery">
      <PipelineSequence>
        <RateController hz="1.0" name="DynamicPathReplanner">
          <Fallback name="ComputeWhenDynamicPathChanges">
            <ReactiveSequence name="KeepValidDynamicPath">
              <SetBlackboard output_key="current_path_valid" value="false"/>
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <TruncatePathLocal input_path="{path}" output_path="{validation_path}" distance_forward="1000.0" distance_backward="0.0"/>
              <IsPathValid path="{validation_path}"/>
              <SetBlackboard output_key="current_path_valid" value="true"/>
              <Inverter>
                <DynamicObstacleChanged status_topic="/ugv/dynamic_replanning/status"/>
              </Inverter>
              <Inverter>
                <PathExpiringTimer seconds="5.0" path="{path}"/>
              </Inverter>
            </ReactiveSequence>
            <Sequence name="ComputeStableDynamicPath">
              <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
              <SelectStableDynamicPath candidate="{candidate_path}" current="{path}" current_valid="{current_path_valid}" selected="{path}"/>
            </Sequence>
            <!-- Dynamic occupancy can temporarily cover the exact goal. Keep
                 the previous controller path alive while D* Lite retries;
                 Predictive DWA and the measured local scan remain active. -->
            <AlwaysSuccess/>
          </Fallback>
        </RateController>
        <RecoveryNode number_of_retries="1" name="RecoveryFollowDynamicPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="RefreshAndReplan">
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Controller" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait name="WaitForFreshScans" wait_duration="0.5"/>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="DynamicRecoveries">
        <GoalUpdated/>
        <RoundRobin name="SensorRefreshRecoveries">
          <Sequence name="ClearDynamicLayers">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait name="WaitForDynamicLayerUpdate" wait_duration="1.0"/>
          </Sequence>
          <Wait name="WaitForMovingObstacle" wait_duration="2.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
